# Neon Postgres (optional locally). Newsletter + contact + experience unlock use it when set.
# Run SQL in portfolio/db/*.sql (including newsletter_subscriptions.sql) in the Neon SQL editor.
# DATABASE_URL=postgresql://...

# Email service (Resend — https://resend.com)
# Required for the contact form to send emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" address shown in outgoing emails.
# Must be a verified domain in your Resend account.
RESEND_FROM_EMAIL=Contact <hello@yourdomain.com>

# The inbox where contact form submissions are delivered.
RESEND_TO_EMAIL=hello@yourdomain.com

# Resend audience ID for newsletter signups (optional — get from Resend dashboard)
RESEND_AUDIENCE_ID=aud_...

# Bundle analyser — set to "true" to open a visual bundle report after build.
# ANALYZE=false

# Dev only: when you open the site from another device (e.g. http://192.168.x.x:3000),
# Next.js may block /_next/* cross-origin requests. Add your dev origin(s), comma-separated.
# NEXT_DEV_ALLOWED_ORIGINS=http://192.168.1.10:3000

# Agent factory — scripts do not load this file; use shell export alongside pnpm `factory:*` scripts.
# export FACTORY_IMPLEMENT_BACKEND=cursor
# If FACTORY_CLAUDE_BIN points at scripts/agent-factory/aider-bridge.sh, default model is Gemini Flash:
# export GEMINI_API_KEY=...
# export AIDER_MODEL=gemini/gemini-2.0-flash-exp
# Meaningful-diff gate for stock factory:implement (optional overrides):
# export FACTORY_REQUIRE_MEANINGFUL_PATHS=0
# export FACTORY_MEANINGFUL_PATH_PREFIXES=middleware.ts,styles/
# Reclaim thresholds — empty or 0 falls back to script defaults
# export FACTORY_STALE_RUN_MS=3600000
# export FACTORY_STALE_CLAIM_MS=900000
# Implement and verify in repo root on main (no .agent-worktrees/*); requires clean main, FACTORY_MERGE_STRATEGY=direct.
# pnpm factory:run-once:main
# export FACTORY_IMPLEMENT_ON_MAIN=1
# export FACTORY_IMPLEMENT_ON_MAIN_INSTALL=1
# Worktree install retries (factory:run-once)
# export FACTORY_INSTALL_RETRIES=3
# export FACTORY_INSTALL_RETRY_DELAY_MS=10000
#
# Local Ollama live page (http://localhost:3000/ollama-live) — server polls Ollama; set in shell before pnpm dev.
# export FF_OLLAMA_LIVE_STATS=1
# export OLLAMA_MONITOR_ORIGIN=http://127.0.0.1:11434
