// Purpose: VS Code / Cursor launch config to run `pnpm dev` from the repo root.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "portfolio (dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
